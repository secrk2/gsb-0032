# 复制为 .env 后按需修改（不设也有默认值，可直接 docker compose up）

# 对外访问端口（compose 中固定映射 8129:80）
# 如需改端口，编辑 docker-compose.yml 的 frontend.ports

MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=zhiyue
MYSQL_USER=zhiyue
MYSQL_PASSWORD=zhiyue

